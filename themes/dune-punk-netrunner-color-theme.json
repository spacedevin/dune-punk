  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#909094",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.name.variable",
        "string constant.other.placeholder",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#EEFFFF"
      }
    },
    {
      "name": "Language variables (this/self)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#E455AE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#B2CCD6"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#E455AE"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#CB1DCD"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#1AC5B0"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic",
        "variable.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#5DF4FE"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.method",
        "meta.class-method entity.name.function",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#5DF4FE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes / types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.module",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#1AC5B0"
      }
    },
    {
      "name": "Interfaces / type params",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter",
        "entity.name.type.alias",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#28C775"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
