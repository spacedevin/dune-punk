{
  "name": "dune-punk",
  "displayName": "Dune Punk",
  "description": "Cyberpunk 2077 / Daemon 2.0 theme collection with a matching icon theme. Five variants: Daemon, Netrunner, Arasaka, Samurai, Edgerunner. Full editor, terminal and workbench colors in VS Code, VSCodium and Cursor; in Dune it also restyles the whole app (chamfered frames, Kvantum controls, scanlines, HUD motion).",
  "version": "0.1.0",
  "publisher": "dune",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spacedevin/dune-punk.git"
  },
  "homepage": "https://github.com/spacedevin/dune-punk#readme",
  "bugs": {
    "url": "https://github.com/spacedevin/dune-punk/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#210E15",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "icon-theme",
    "cyberpunk",
    "cyberpunk 2077",
    "daemon",
    "neon",
    "dark",
    "dune"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev-install": "node build.mjs && sh scripts/dev-install.sh",
    "package": "node build.mjs && npx -y @vscode/vsce package --no-dependencies",
    "publish:ovsx": "node build.mjs && npx -y ovsx publish --no-dependencies -p $OVSX_PAT"
  },
  "contributes": {
    "themes": [
      {
        "id": "Dune Punk Daemon",
        "label": "Dune Punk Daemon",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-punk-daemon-color-theme.json"
      },
      {
        "id": "Dune Punk Netrunner",
        "label": "Dune Punk Netrunner",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-punk-netrunner-color-theme.json"
      },
      {
        "id": "Dune Punk Arasaka",
        "label": "Dune Punk Arasaka",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-punk-arasaka-color-theme.json"
      },
      {
        "id": "Dune Punk Samurai",
        "label": "Dune Punk Samurai",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-punk-samurai-color-theme.json"
      },
      {
        "label": "Dune Punk Edgerunner",
        "uiTheme": "vs-dark",
        "path": "./themes/dune-punk-edgerunner-color-theme.json",
        "id": "Dune Punk Edgerunner"
      }
    ],
    "iconThemes": [
      {
        "id": "dune-punk-icons",
        "label": "Dune Punk Icons",
        "path": "./icons/dune-punk-icon-theme.json"
      },
      {
        "id": "dune-punk-circles",
        "label": "Dune Punk Circles",
        "path": "./icons/dune-punk-circles-icon-theme.json"
      }
    ],
    "duneThemeCollections": [
      {
        "id": "dune.punk",
        "label": "Dune Punk",
        "order": 4,
        "blurb": "Neon on burgundy night. Wake up, Samurai \u2014 the city needs a commit.",
        "themes": [
          "Dune Punk Daemon",
          "Dune Punk Netrunner",
          "Dune Punk Arasaka",
          "Dune Punk Samurai",
          "Dune Punk Edgerunner"
        ]
      }
    ]
  }
}
